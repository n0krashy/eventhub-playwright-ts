# Copy this file to .env and fill in two disposable test accounts.
# .env is git-ignored. In CI these come from repository secrets.
# The accounts are registered automatically on the first run if they do not exist yet.
EVENTHUB_EMAIL=
EVENTHUB_PASSWORD=
EVENTHUB_EMAIL_2=
EVENTHUB_PASSWORD_2=

# Optional. The defaults point at the live EventHub site.
# BASE_URL=https://eventhub.rahulshettyacademy.com
# API_URL=https://api.eventhub.rahulshettyacademy.com/api
